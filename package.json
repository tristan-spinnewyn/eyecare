{
  "name": "eyecare-20-20-20",
  "version": "1.1.1",
  "description": "Eyecare 20-20-20 — réduisez la fatigue oculaire en suivant la règle des 20-20-20",
  "main": "src/main/main.js",
  "author": "Tristan Spinnewyn <tristan.spinnewyn@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristan-spinnewyn/eyecare.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "make:icon": "node scripts/make-icon.cjs",
    "predist": "node scripts/make-icon.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.eyecare.app",
    "productName": "Eyecare 20-20-20",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "locales/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Eyecare-20-20-20-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Eyecare-20-20-20-${version}.${ext}",
      "category": "Utility",
      "maintainer": "Tristan Spinnewyn <tristan.spinnewyn@protonmail.com>"
    }
  }
}
