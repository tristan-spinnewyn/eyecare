{
  "name": "eyecare-20-20-20",
  "version": "0.1.0",
  "description": "Eyecare 20-20-20 — réduisez la fatigue oculaire en suivant la règle des 20-20-20",
  "main": "src/main/main.js",
  "author": "Tristan Spinnewyn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristan-spinnewyn/eyecare.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "com.eyecare.app",
    "productName": "Eyecare 20-20-20",
    "files": [
      "src/**/*",
      "assets/**/*",
      "locales/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Eyecare-20-20-20-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Eyecare-20-20-20-${version}.${ext}",
      "category": "Utility"
    }
  }
}
